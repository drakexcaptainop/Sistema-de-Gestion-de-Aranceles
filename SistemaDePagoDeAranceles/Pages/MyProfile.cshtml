@page "/MyProfile"
@model SistemaDePagoDeAranceles.Pages.MyProfileModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h2 class="mb-3">Mi Perfil</h2>
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Usuario</dt>
                    <dd class="col-sm-8">@Model.Username</dd>

                    <dt class="col-sm-4">Primer nombre</dt>
                    <dd class="col-sm-8">@Model.FirstName</dd>

                    <dt class="col-sm-4">Apellido</dt>
                    <dd class="col-sm-8">@Model.LastName</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Rol</dt>
                    <dd class="col-sm-8">@Model.RoleName</dd>
                </dl>
            </div>
            <a asp-page="/ChangePassword"
               class="btn btn-outline-primary d-inline-flex align-items-center gap-2 mt-3">
                <i class="bi bi-key-fill"></i> Cambiar contraseña
            </a>

        </div>
    </div>
</div>
