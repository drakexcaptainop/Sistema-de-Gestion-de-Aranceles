@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
<table class="table table-striped">
    <thead class="table-primary">
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Monto Base</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Categories.Any())
        {
            @foreach (var item in Model.Categories)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.BaseAmount</td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center text-muted">No hay categorías registradas.</td>
            </tr>
        }

    </tbody>
</table>


<table class="table table-hover align-middle">
    <thead class="table-primary">
        <tr>
            <th>Nombre</th>
            <th>NIT</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Tipo</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Establishments.Any())
        {
            @foreach (var e in Model.Establishments)
            {
                <tr>
                    <td>@e.Name</td>
                    <td>@e.TaxId</td>
                    <td>@e.Phone</td>
                    <td>@e.Email</td>
                    <td>@e.EstablishmentType</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No hay establecimientos registrados.</td>
            </tr>
        }
    </tbody>
</table>