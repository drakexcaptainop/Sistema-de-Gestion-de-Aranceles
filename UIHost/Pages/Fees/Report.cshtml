@page
@model UIHost.Pages.Fees.ReportModel

@{
    ViewData["Title"] = "Reporte de Aranceles";
}

<!-- HEADER -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
    <div>
        <h2 class="mb-1 fw-bold text-dark">
            <i class="bi bi-file-earmark-text-fill text-primary me-2"></i>
            @ViewData["Title"]
        </h2>
        <p class="text-muted mb-0 small">
            Genera reportes en formato PDF o Excel filtrando por fecha o monto.
        </p>
    </div>
</div>

<!-- FILTER FORM -->
<form method="post" asp-page-handler="GenerateReport" class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="row g-3">
            <!-- Report Type -->
            <div class="col-md-4">
                <label class="form-label fw-semibold">Tipo de reporte</label>
                <select asp-for="ReportType" class="form-select" required>
                    <option value="pdf" selected>PDF</option>
                    <option value="excel">Excel</option>
                </select>
            </div>

            <!-- Date Range -->
            <div class="col-md-4">
                <label class="form-label fw-semibold">Desde</label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold">Hasta</label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>

            <!-- Amount Range -->
            <div class="col-md-6">
                <label class="form-label fw-semibold">Monto mínimo (Bs.)</label>
                <input asp-for="MinAmount" type="number" step="0.01" class="form-control" placeholder="Ej: 100.00" />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold">Monto máximo (Bs.)</label>
                <input asp-for="MaxAmount" type="number" step="0.01" class="form-control" placeholder="Ej: 1000.00" />
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4 gap-2">
            <a asp-page="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver
            </a>

            <button type="submit"
                    class="btn btn-success"
                    formaction="?handler=GenerateReport"
                    id="generateBtn">
                <span class="spinner-border spinner-border-sm me-2 d-none" id="loadingSpinner"></span>
                <i class="bi bi-file-earmark-arrow-down"></i> Generar Reporte
            </button>
        </div>
    </div>
</form>


