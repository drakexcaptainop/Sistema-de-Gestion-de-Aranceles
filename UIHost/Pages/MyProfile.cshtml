@page "/MyProfile"
@model UIHost.Pages.MyProfileModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<!-- HEADER -->
<div class="mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-person-circle text-primary me-2"></i>@ViewData["Title"]
            </h2>
            <p class="text-muted mb-0 small">Información de tu cuenta en el sistema</p>
        </div>
        <a asp-page="/ChangePassword" class="btn btn-outline-primary px-4">
            <i class="bi bi-key-fill me-2"></i>Cambiar Contraseña
        </a>
    </div>
    <hr class="border-2 opacity-25">
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow border-0">
            <div class="card-body p-3.5 p-md-4">

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-semibold mb-3">
                        <i class="bi bi-person-badge text-primary me-2"></i>Usuario
                    </dt>
                    <dd class="col-sm-8 mb-3">
                        <span class="fw-semibold">@Model.Username</span>
                    </dd>

                    <dt class="col-sm-4 text-muted fw-semibold mb-3">
                        <i class="bi bi-person text-primary me-2"></i>Nombres
                    </dt>
                    <dd class="col-sm-8 mb-3">@Model.FirstName</dd>

                    <dt class="col-sm-4 text-muted fw-semibold mb-3">
                        <i class="bi bi-person text-primary me-2"></i>Apellidos
                    </dt>
                    <dd class="col-sm-8 mb-3">@Model.LastName</dd>

                    <dt class="col-sm-4 text-muted fw-semibold mb-3">
                        <i class="bi bi-envelope text-primary me-2"></i>Email
                    </dt>
                    <dd class="col-sm-8 mb-3">
                        <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                    </dd>

                    <dt class="col-sm-4 text-muted fw-semibold mb-0">
                        <i class="bi bi-shield-check text-primary me-2"></i>Rol
                    </dt>
                    <dd class="col-sm-8 mb-0">
                        <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-2">@Model.RoleName</span>
                    </dd>
                </dl>

            </div>
        </div>
    </div>
</div>